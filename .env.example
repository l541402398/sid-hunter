# 复制为 .env（.env 不会被提交）。只需要 CAS 地址，登录会话保存在本进程内存。
TOKEN_EXPIRE=604800

# 浏览器登录入口（走 https；{service} 由客户端替换成当前页面地址）
SSO_LOGIN_URL=https://172.26.1.10/login?service={service}
# 票据校验端点（服务端访问）。公司 CAS 的证书链在多数机器上不受信：
# Node fetch 走 https 会直接失败（UNABLE_TO_VERIFY_LEAF_SIGNATURE），而 curl -k 能通过，
# 很容易误判成“登录成功但进不去游戏”，因此校验固定用 http://…/p3/serviceValidate，
# 登录入口仍用 https。cas.x 只是占位符，部署时必须覆盖成实际 CAS 主机。
SSO_VALIDATE_URL=http://172.26.1.10/p3/serviceValidate?service={service}&ticket={ticket}
