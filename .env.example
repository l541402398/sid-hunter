# 复制为 .env（.env 不会被提交）。只需要 CAS 地址，登录会话保存在本进程内存。
TOKEN_EXPIRE=604800

# 浏览器登录入口（走 https；{service} 由客户端替换成当前页面地址）
SSO_LOGIN_URL=https://172.26.1.10/login?service={service}
# 票据校验端点（服务端访问）。公司 CAS 的证书链在多数机器上不受信：
# Node fetch 走 https 会直接失败（UNABLE_TO_VERIFY_LEAF_SIGNATURE），而 curl -k 能通过，
# 很容易误判成“登录成功但进不去游戏”，因此校验固定用 http://…/p3/serviceValidate，
# 登录入口仍用 https。cas.x 只是占位符，部署时必须覆盖成实际 CAS 主机。
SSO_VALIDATE_URL=http://172.26.1.10/p3/serviceValidate?service={service}&ticket={ticket}

# 员工档案同步（工号 → 性别 → 男/女形象）。
# /profiles 是 HTML 页面；真正的 JSON 列表是 /profilesAll，需要 CAS 会话。
# 只需要成功同步一次时：留空 PROFILE_API_TOKEN/COOKIE，用一次性票据或导入 JSON（见 README）。
# 未登录会 302 到统一登录页；服务端需要一个可用凭证，任选其一：
#   PROFILE_API_TICKET  — 一次性 CAS 票据，拼成 /profilesAll?ticket=ST-...；票据通常只能用一次
#   PROFILE_API_TOKEN   — 以 token 头（公司 CAS 约定）和 Authorization: Bearer 发送
#   PROFILE_API_COOKIE  — 以 Cookie 头发送（例如浏览器里 profile.app.x 的 JSESSIONID=...）
#   PROFILE_API_HEADERS — 额外请求头 JSON，如 {"X-Internal-Token":"..."}
# 留空则只使用本地已同步的员工库；同步失败不会阻塞游戏，形象退回随机。
PROFILE_API_URL=http://profile.app.x/profilesAll
PROFILE_API_TICKET=
PROFILE_API_TOKEN=
PROFILE_API_COOKIE=
PROFILE_API_HEADERS=
# 默认 0 = 只在服务启动时同步一次。需要定时刷新时才设成正数毫秒。
PROFILE_SYNC_INTERVAL_MS=0
PROFILE_TIMEOUT_MS=30000
# 调试时可设 0 关闭启动同步（仍可读取已落库的数据）。
# SID_PROFILE_SYNC=0
